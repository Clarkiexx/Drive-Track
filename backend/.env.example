NODE_ENV=development
PORT=5000

# Required. Must be at least 32 characters and must not be the placeholder
# below — utils/jwt.js refuses to start without a strong secret.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed browser origins for CORS.
# TWO browser clients talk to this API, so both dev origins must be allowed or
# every request from one of them is blocked at the preflight:
#   - the Next.js PWA (frontend/) runs on :3000
#   - the Vite admin dashboard (admin-dashboard/) runs on :5173
# Add your LAN IP too when testing the PWA from a phone on the same Wi-Fi,
# e.g. http://192.168.1.24:3000 — see frontend/.env.example for the matching
# NEXT_PUBLIC_API_URL setting.
# The native Expo apps sent no Origin header and are unaffected by this list.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Optional one-time seed credentials (used by seed-admin.js / seed-enforcer.js).
# If unset, the seed scripts fall back to documented dev defaults and print
# a reminder to change them.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ENFORCER_USERNAME=jsantos
SEED_ENFORCER_PASSWORD=

# Number of days after issuance a citation's payment is due
CITATION_DUE_DAYS=15

# Phase 4 — Xendit online payments (Payment Sessions API).
# Secrets stay server-side; never commit real values.
# Leave XENDIT_SECRET_KEY empty to disable online checkout (drivers are
# told to pay at the CTMO office instead).
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_SUCCESS_RETURN_URL=http://localhost:5000/api/v1/payments/return?status=success
XENDIT_CANCEL_RETURN_URL=http://localhost:5000/api/v1/payments/return?status=cancelled
# Optional: comma-separated Xendit channel codes (confirmed from the Xendit
# dashboard). When empty, all dashboard-enabled channels are offered.
XENDIT_ALLOWED_CHANNELS=
# Optional override, defaults to https://api.xendit.co
# XENDIT_API_URL=https://api.xendit.co

# ---------------------------------------------------------------------------
# Neon (PostgreSQL) — the database is owned by Prisma.
# DATABASE_URL          = POOLED endpoint -> used by the app at RUNTIME.
# DATABASE_URL_UNPOOLED = DIRECT endpoint  -> used ONLY by prisma/psql CLI.
# The direct host is the pooled host with "-pooler" removed from the hostname.
# Never run DDL through the pooler. Real credentials live in .env (gitignored).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.c-N.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.c-N.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
