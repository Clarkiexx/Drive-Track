# Copy to .env.local for local development (this file is committed, .env.local is ignored).
# NEXT_PUBLIC_* vars are inlined at BUILD time, so the app must be rebuilt —
# restart `npm run dev` or re-run `npm run build` — after changing any of them.

# ---------------------------------------------------------------------------
# Backend API base URL (lib/axios.ts API_BASE_URL).
#   * MUST end with /api/v1 — backend/src/app.js mounts every router under
#     /api/v1, and lib/axios.ts uses this value as-is (no suffix is added).
#     A missing suffix makes every call hit a 404 "Route not found".
#   * Desktop browser: this is fine —
#         NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
#   * Phone / any other device: `localhost` on the phone means THE PHONE, not
#     your computer, so every request dies there. Use your computer's LAN IP
#     instead (ipconfig on Windows, ifconfig on macOS), phone and computer on
#     the same Wi-Fi:
#         NEXT_PUBLIC_API_URL=http://192.168.1.24:5000/api/v1
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ---------------------------------------------------------------------------
# Public origin of this PWA (no trailing slash).
# Used for absolute links and return/redirect targets in the UI (e.g. sending
# the driver back from a payment flow) and anywhere an absolute app URL is
# needed. Media files are NOT served from here: /uploads/* lives on the API
# host, so lib/media.ts derives it from NEXT_PUBLIC_API_URL with the /api/v1
# suffix stripped (mirrors driver-app/src/config.js getMediaBaseUrl()).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Backend-side (set in backend/.env, not here) — CORS_ORIGIN:
#   browser requests are blocked unless this comma-separated list includes the
#   PWA origin, i.e. at minimum:
#       CORS_ORIGIN=http://localhost:3000
#   (backend/.env.example ships with http://localhost:5173, the legacy admin
#   SPA — that value alone will reject every fetch from this PWA with a CORS
#   error, even with a valid token.)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Field-testing gotcha — GPS capture (enforcer citation wizard) uses
# navigator.geolocation, which browsers only expose on a secure context:
# HTTPS or localhost. Serving the PWA from a phone over plain
# http://<LAN_IP>:3000 means the GPS fix is denied before the wizard can take
# one — tunnel the dev server over HTTPS (e.g. `npx ngrok http 3000`) for
# on-site testing.
# ---------------------------------------------------------------------------
